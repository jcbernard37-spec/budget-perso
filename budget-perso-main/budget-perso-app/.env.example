# Copie ce fichier en ".env" et colle ton Client ID Google OAuth (voir README.md)
VITE_GOOGLE_CLIENT_ID=ton_client_id.apps.googleusercontent.com

# GEMINI_API_KEY (import de document par IA) : NE PAS la mettre ici pour un usage
# normal. Elle doit être ajoutée directement dans Vercel → Settings → Environment
# Variables, jamais avec le préfixe VITE_ (qui l'enverrait au navigateur).
# Elle n'est utile ici que si tu testes en local avec `vercel dev` (voir README.md).
GEMINI_API_KEY=ta_cle_gemini
